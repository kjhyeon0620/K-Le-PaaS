    {
      "id": "normal-deploy-repo-branch",
      "group": "normal",
      "input": "저장소 3번 main 브랜치 배포해줘",
      "expected_intents": [
        "DEPLOY"
      ],
      "expected_args": {
        "repository_id": 3,
        "branch_name": "main"
      },
      "expected_risk": "HIGH",
      "note": "ID와 브랜치가 모두 입력에 있다"
    },
    {
      "id": "normal-deploy-commit-en",
      "group": "normal",
      "input": "Deploy repository 5 at commit a1b2c3d",
      "expected_intents": [
        "DEPLOY"
      ],
      "expected_args": {
        "repository_id": 5,
        "commit_hash": "a1b2c3d"
      },
      "expected_risk": "HIGH",
      "note": "영어, 커밋 지정"
    },
    {
      "id": "normal-scale-by-id",
