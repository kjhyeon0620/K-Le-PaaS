{
  "uid": "klepaas-llm",
  "title": "K-Le-PaaS LLM 사용량",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LLM 호출 (재기동 이후)",
      "description": "재기동 이후 누적. 지표는 메모리에 있어 재기동하면 0부터 다시 센다",
      "datasource": {
        "type": "prometheus",
        "uid": "klepaas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "klepaas-prometheus"
          },
          "expr": "sum by (feature, outcome) (klepaas_llm_calls_total)",
          "legendFormat": "{{feature}} {{outcome}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LLM 지연 (성공 호출, 재기동 이후)",
      "description": "재기동 이후 누적. 지표는 메모리에 있어 재기동하면 0부터 다시 센다. p50·p95는 히스토그램 구간에서 추정한 값",
      "datasource": {
        "type": "prometheus",
        "uid": "klepaas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "klepaas-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, feature) (klepaas_llm_latency_seconds_bucket))",
          "legendFormat": "p50 {{feature}}",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "klepaas-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, feature) (klepaas_llm_latency_seconds_bucket))",
          "legendFormat": "p95 {{feature}}",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "klepaas-prometheus"
          },
          "expr": "sum by (feature) (klepaas_llm_latency_seconds_sum) / sum by (feature) (klepaas_llm_latency_seconds_count)",
          "legendFormat": "평균 {{feature}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "horizontal"
      }
    },
    {
